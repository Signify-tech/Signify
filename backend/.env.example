# Copy to backend/.env and adjust. Real environment variables take precedence.
SIGNIFY_DB_URL=jdbc:postgresql://localhost:5432/signify
SIGNIFY_DB_USERNAME=your_postgres_user
SIGNIFY_DB_PASSWORD=change_me
SIGNIFY_PORT=8080
SIGNIFY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIGNIFY_MEDIA_DIR=../media
SIGNIFY_SEED_FILE=../data/vocabulary.csv
SIGNIFY_SEED_ON_STARTUP=true
