# Copy to backend/.env and adjust. Real environment variables take precedence.
SIGNIFY_DB_URL=jdbc:postgresql://localhost:5432/signify
SIGNIFY_DB_USERNAME=your_postgres_user
SIGNIFY_DB_PASSWORD=change_me
SIGNIFY_PORT=8080
SIGNIFY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIGNIFY_MEDIA_DIR=../media
SIGNIFY_SEED_FILE=../data/vocabulary.csv
SIGNIFY_SEED_ON_STARTUP=true
# Render supplies PORT. Container paths and the production profile are set by Dockerfile.
# Neon: jdbc:postgresql://<host>/<database>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&channelBinding=require
# Set the Neon username/password separately in Render, never in Git or the JDBC URL.
# Render: explicitly set SPRING_PROFILES_ACTIVE=production; use SIGNIFY_DB_* consistently.
# Remove conflicting SPRING_DATASOURCE_*, SPRING_DATASOURCE_HIKARI_* and SPRING_FLYWAY_* connection overrides.
# Production requires a nonblank password and rejects loopback URLs before opening any connection.
# Production CORS: exact https://<your-project>.vercel.app origin (no path or trailing slash).
